<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="5.0.1" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="5.0.1" NoWarn="NU1605" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="5.6.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="JobTracker.Application/JobTracker.Application.csproj" />
    <ProjectReference Include="JobTracker.Infrastructure/JobTracker.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Exclude source files that belong to subdirectory projects to avoid duplicate compilation -->
  <ItemGroup>
    <Compile Remove="JobTracker.Api/**" />
    <Compile Remove="JobTracker.Application/**" />
    <Compile Remove="JobTracker.Domain/**" />
    <Compile Remove="JobTracker.Infrastructure/**" />
  </ItemGroup>

</Project>
